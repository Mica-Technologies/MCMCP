{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCMCP Orchestrator",
  "version": "0.1.0",
  "identifier": "com.micatechnologies.mcmcp.orchestrator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "MCMCP Orchestrator",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mcmcp-orchestrator"
    ]
  }
}
